# Frontend settings. Copy to .env.local to change them (git-ignored).
#   PowerShell:  Copy-Item .env.example .env.local
#
# WARNING: every VITE_ value is built into the JavaScript that browsers
# download. It is PUBLIC. Never put passwords or secret keys here.

# Where the backend API runs. Change the port if you set SERVER_PORT in the
# root .env (e.g. http://localhost:8081).
VITE_API_URL=http://localhost:8080

# true = show built-in sample products instead of calling the backend
# (useful to work on the design without starting the backend).
VITE_USE_SAMPLE_DATA=false
