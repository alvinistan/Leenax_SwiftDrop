# Copy this file to .env and change the values.  (.env is git-ignored.)
#   PowerShell:  Copy-Item .env.example .env
# Used by docker-compose.yml AND by the Spring Boot backend.

DB_HOST=localhost
# Change DB_PORT (e.g. 5433) if PostgreSQL is already installed on your PC.
DB_PORT=5432
DB_NAME=swiftdrop
DB_USERNAME=swiftdrop
# Local development only. Pick any password; never reuse a real one.
DB_PASSWORD=change-me

# The first administrator account, created when the backend starts and no
# admin exists yet. Use your own email and a long password (12+ characters).
# After the first successful start you may remove ADMIN_PASSWORD.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-password

# Browser origins allowed to call the API (comma-separated). Default: the
# Vite dev server. Only change it if the frontend runs on another address.
# CORS_ALLOWED_ORIGINS=http://localhost:5173
