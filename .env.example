# Copy this file to .env and change the values.  (.env is git-ignored.)
#   PowerShell:  Copy-Item .env.example .env
# Used by docker-compose.yml AND by the Spring Boot backend.

DB_HOST=localhost
# Change DB_PORT (e.g. 5433) if PostgreSQL is already installed on your PC.
DB_PORT=5432
DB_NAME=swiftdrop
DB_USERNAME=swiftdrop
# Local development only. Pick any password; never reuse a real one.
DB_PASSWORD=change-me

# Image storage (S3). For local development, images go to S3Mock from
# docker-compose (no AWS account needed). To use real AWS S3 later, remove
# S3_ENDPOINT and follow docs/AWS_SETUP.md. NEVER put AWS keys in this file.
S3_ENDPOINT=http://localhost:9090
S3_BUCKET=swiftdrop-images
AWS_REGION=ap-south-1

# The first administrator account, created when the backend starts and no
# admin exists yet. Use your own email and a long password (12+ characters).
# After the first successful start you may remove ADMIN_PASSWORD.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-password

# Browser origins allowed to call the API (comma-separated). Default: the
# Vite dev server. Only change it if the frontend runs on another address.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Online card payments with PayHere (Phase 9). Card payment is offered only
# when the merchant id, merchant secret and public API address are all set.
# Get them from your PayHere account: Side menu > Integrations.
# NEVER commit the real secret: keep it only in your own .env.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# sandbox (testing) or live
PAYHERE_MODE=sandbox
# Public https address of this backend so PayHere can send payment
# notifications (localhost does NOT work; see docs/payments/PAYHERE.md)
PAYHERE_PUBLIC_API_BASE_URL=
FRONTEND_BASE_URL=http://localhost:5173

# Phase 11: request limits and login lockout (docs/SECURITY.md). Keep "true".
# RATE_LIMIT_ENABLED=true
# Behind a load balancer / reverse proxy only (Phase 14): use the client's real IP.
# FORWARD_HEADERS_STRATEGY=native
